#!/bin/bash
#PBS -N habitat3d
#PBS -q parallel
#PBS -l select=1:ncpus=24:mem=48gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o habitat3d_job.out

# =============================================================================
# Job Setup (User Original Env)
# =============================================================================

cd "$PBS_O_WORKDIR" || exit 1
LOG="habitat3d_log_${PBS_JOBID%%.*}.txt"

echo "Job ${PBS_JOBID} started at: $(date)" > "$LOG"
echo "Node: $(hostname)" >> "$LOG"

# 1. Force Software Rendering (Safe default for CPU env)
export LIBGL_ALWAYS_SOFTWARE=1
export MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
export MAGNUM_LOG=quiet
export MAGNUM_GPU_VALIDATION=OFF

echo "Running in Standard CPU Mode (User Env)" >> "$LOG"

# 2. Environment Variables
export PYTHONIOENCODING=utf-8

# Ray Configuration
export RAY_TMPDIR=/tmp/ray
mkdir -p $RAY_TMPDIR
rm -rf $RAY_TMPDIR/*
export RAY_DASHBOARD_HOST=0.0.0.0
export RAY_DASHBOARD_PORT=8265
export RAY_ENABLE_WINDOWS_OR_OSX_CLUSTER=1

# 3. Activate Conda Environment
source ~/.bashrc || true
if command -v conda >/dev/null 2>&1; then
  source "$(conda info --base)/etc/profile.d/conda.sh" || true
  # 自动激活环境: /hpctmp/<user>/envs/habitat
  conda activate /hpctmp/$(whoami)/envs/habitat || conda activate habitat
fi
echo "Environment activated: $CONDA_DEFAULT_ENV" >> "$LOG"

# 4. Library Path Configuration (The "Nuclear" Fix for EGL/Sysroot)
export HABITAT_ENV_LIB="/hpctmp/$(whoami)/envs/habitat/lib"
export LD_LIBRARY_PATH="$HABITAT_ENV_LIB:$LD_LIBRARY_PATH"

# Force using Conda's libstdc++ AND libGL to avoid host library mismatch
PRELOAD_LIBS=""

if [ -f "$HABITAT_ENV_LIB/libstdc++.so.6" ]; then
    PRELOAD_LIBS="$HABITAT_ENV_LIB/libstdc++.so.6"
fi

if [ -f "$HABITAT_ENV_LIB/libGL.so.1" ]; then
    if [ -n "$PRELOAD_LIBS" ]; then
        PRELOAD_LIBS="$PRELOAD_LIBS:$HABITAT_ENV_LIB/libGL.so.1"
    else
        PRELOAD_LIBS="$HABITAT_ENV_LIB/libGL.so.1"
    fi
fi

if [ -n "$PRELOAD_LIBS" ]; then
    export LD_PRELOAD="$PRELOAD_LIBS"
    echo "Preloaded Libraries: $LD_PRELOAD" >> "$LOG"
fi

echo "LD_LIBRARY_PATH: $LD_LIBRARY_PATH" >> "$LOG"

# 5. Run the Driver
echo "Starting Driver..." >> "$LOG"
python driver.py >> "$LOG" 2>&1
